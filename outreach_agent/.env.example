# ── Notion ────────────────────────────────────────────────────────────────────
# Get your integration token at https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The ID of your "Customer Discovery - Italian CFOs" database
# (found in the database URL: notion.so/<workspace>/<DATABASE_ID>?v=...)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Gemini ─────────────────────────────────────────────────────────────────────
# Get your API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Your Gmail address
GMAIL_ADDRESS=you@gmail.com

# Generate an App Password at: Google Account → Security → 2FA → App passwords
# Use "Mail" as the app name. The password looks like: xxxx xxxx xxxx xxxx
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Optional settings (defaults shown) ────────────────────────────────────────
# Paths to your email templates (relative to outreach_agent/)
TEMPLATE_PATH=templates/outreach.txt
FOLLOWUP_1_TEMPLATE_PATH=templates/followup_1.txt
FOLLOWUP_2_TEMPLATE_PATH=templates/followup_2.txt

# Follow-up timing: days after previous email before sending next one
# "2,4" means: follow-up 1 after 2 days, follow-up 2 after 4 days from initial
FOLLOWUP_INTERVALS_DAYS=2,4

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
